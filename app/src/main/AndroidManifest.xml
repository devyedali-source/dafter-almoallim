<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link Intent Filter for Section Activation (Custom Scheme) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="daftarmeallim" />
                <data android:scheme="daftarmeallim" android:host="activate" />
            </intent-filter>

            <!-- Deep Link Intent Filter for Section Activation (Web Domain) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/activate"
                    android:scheme="https" />
                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/activate"
                    android:scheme="http" />
                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/exchange-approve"
                    android:scheme="https" />
                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/exchange-approve"
                    android:scheme="http" />
                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/course-activate"
                    android:scheme="https" />
                <data
                    android:host="diftar-almoaalim.web.app"
                    android:pathPrefix="/course-activate"
                    android:scheme="http" />
            </intent-filter>

            <!-- Other domains in a separate intent-filter to prevent verification failures from blocking the main domain -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/activate"
                    android:scheme="https" />
                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/activate"
                    android:scheme="http" />
                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/exchange-approve"
                    android:scheme="https" />
                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/exchange-approve"
                    android:scheme="http" />
                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/course-activate"
                    android:scheme="https" />
                <data
                    android:host="daftarmeallim.app"
                    android:pathPrefix="/course-activate"
                    android:scheme="http" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
